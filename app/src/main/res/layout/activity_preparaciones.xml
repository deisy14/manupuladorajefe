<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFDF5">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:gravity="center"
        android:text="Preparaciones de hoy"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#38352E"/>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:text="Viernes 22 de agosto"
        android:textAlignment="center"
        android:textSize="12sp"
        android:textColor="#77746B"/>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_amarilla"
                android:padding="10dp">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="85dp"
                    android:src="@drawable/pollo"
                    android:background="@drawable/bg_card"
                    android:padding="25dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pollo guisado"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#38352E"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Almuerzo · 120 estudiantes"
                        android:textSize="11sp"
                        android:textColor="#77746B"/>

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="VER DETALLE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#38352E"
                        android:background="@drawable/bg_boton_outline"
                        android:layout_marginTop="6dp"/>

                </LinearLayout>

            </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Componentes y avance"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#38352E"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp"/>


            <!-- ARROZ -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="10dp">

                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/arroz"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arroz blanco"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#38352E"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="María López"
                        android:textSize="10sp"
                        android:textColor="#77746B"/>

                </LinearLayout>

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="70%"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textColor="#8A7200"/>

            </LinearLayout>


            <!-- POLLO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="10dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/pollo"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pollo"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#38352E"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carolina Ruiz"
                        android:textSize="10sp"
                        android:textColor="#77746B"/>

                </LinearLayout>

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="40%"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textColor="#8A7200"/>

            </LinearLayout>


            <!-- ENSALADA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="10dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/ensalada"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ensalada"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#38352E"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carolina Ruiz"
                        android:textSize="10sp"
                        android:textColor="#77746B"/>

                </LinearLayout>

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textColor="#77746B"/>

            </LinearLayout>


            <!-- BEBIDA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="10dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/bebida"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bebida natural"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#38352E"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Luisa Fernández"
                        android:textSize="10sp"
                        android:textColor="#77746B"/>

                </LinearLayout>

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textColor="#4D9135"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <include
        layout="@layout/layout_barra_inferior"/>

</LinearLayout>