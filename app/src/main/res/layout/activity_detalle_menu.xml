<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFDF5">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFDF5"
        android:padding="15dp">

        <ImageView
            android:id="@+id/btnVolver"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_flecha_izquierda"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Detalle del menú"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#38352E"/>

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_corazon"/>

    </RelativeLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:src="@drawable/pollo"
                android:background="@drawable/bg_card"
                android:padding="55dp"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pollo guisado"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#38352E"
                    android:padding="8dp"/>

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="35dp"
                    android:gravity="center"
                    android:text="Almuerzo"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#38352E"
                    android:background="@drawable/bg_boton_amarillo"/>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="15dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha                 Viernes 22 de agosto"
                    android:textSize="12sp"
                    android:textColor="#38352E"
                    android:padding="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estudiantes          120"
                    android:textSize="12sp"
                    android:textColor="#38352E"
                    android:padding="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Porción estándar     1 plato"
                    android:textSize="12sp"
                    android:textColor="#38352E"
                    android:padding="6dp"/>

            </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Componentes del menú"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#38352E"
                android:layout_marginTop="18dp"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Arroz blanco                         12 kg"
                android:gravity="center_vertical"
                android:textSize="13sp"
                android:textColor="#38352E"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginTop="8dp"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Pollo                                  24 kg"
                android:gravity="center_vertical"
                android:textSize="13sp"
                android:textColor="#38352E"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginTop="6dp"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Ensalada                            10 kg"
                android:gravity="center_vertical"
                android:textSize="13sp"
                android:textColor="#38352E"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginTop="6dp"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Bebida natural                    10 L"
                android:gravity="center_vertical"
                android:textSize="13sp"
                android:textColor="#38352E"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginTop="6dp"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Información nutricional (aprox.)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#38352E"
                android:layout_marginTop="18dp"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Calorías\n650 kcal"
                    android:textSize="11sp"
                    android:textColor="#38352E"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Proteínas\n28 g"
                    android:textSize="11sp"
                    android:textColor="#38352E"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Carbohidratos\n80 g"
                    android:textSize="11sp"
                    android:textColor="#38352E"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Grasas\n18 g"
                    android:textSize="11sp"
                    android:textColor="#38352E"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <TextView
        android:id="@+id/btnElegirMenu"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_margin="15dp"
        android:gravity="center"
        android:text="ELEGIR ESTE MENÚ"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#38352E"
        android:background="@drawable/bg_boton_amarillo"/>

</LinearLayout>